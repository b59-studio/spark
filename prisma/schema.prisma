generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())

  roles           UserRole[]
  contacts        ContactEvent[]
  mapFeatures     MapFeature[]
  magicLinkTokens MagicLinkToken[]
}

/// Single-use magic login links (store only SHA-256 of the secret token).
model MagicLinkToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  userRoles UserRole[]
}

model UserRole {
  id         String  @id @default(uuid())
  userId     String
  roleId     Int
  precinctId Int?
  blockId    Int?
  permissions Json?

  user     User      @relation(fields: [userId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  precinct Precinct? @relation(fields: [precinctId], references: [id])
  block    Block?    @relation(fields: [blockId], references: [id])
}

model Precinct {
  id     Int    @id @default(autoincrement())
  name   String
  county String
  state  String

  blocks     Block[]
  households Household[]
  // FIX: missing back-relations that Prisma requires
  userRoles  UserRole[]
  mapFeatures MapFeature[]
}

model Block {
  id         Int    @id @default(autoincrement())
  name       String
  precinctId Int
  // ADDED: Region and Zone are present in TX*SPARK exports; empty in initial file
  // but preserved for future precinct-walk organizational data
  region     String?
  zone       String?

  precinct   Precinct    @relation(fields: [precinctId], references: [id])
  households Household[]
  // FIX: missing back-relation
  userRoles  UserRole[]
}

model Household {
  id           String  @id @default(uuid())
  address      String
  city         String
  state        String
  zip          String
  lat          Float?
  lng          Float?
  /// PostGIS geography(WGS84 point). Synced from lat/lng via DB trigger.
  locationGeom Unsupported("geography(Point,4326)")?
  pollingPlace String?
  // ADDED: TX*SPARK Address Code for cross-referencing future vendor exports
  sparkCode    String?
  // ADDED: source file tracking for ETL auditability
  importedFrom String?

  precinctId Int
  blockId    Int?

  precinct Precinct  @relation(fields: [precinctId], references: [id])
  block    Block?    @relation(fields: [blockId], references: [id])

  voters   Voter[]
  contacts ContactEvent[]
  summary  HouseholdContactSummary?
}

model Voter {
  id          String  @id @default(uuid())
  vuid        String  @unique
  firstName   String
  // ADDED: middleName — TX voter files encode "FIRST MIDDLE" together; splitting
  // now prevents needing a schema migration when you want to query by middle name
  middleName  String?
  lastName    String
  gender      String?
  age         Int?
  race        String?
  status      String?
  // ADDED: source file tracking
  importedFrom String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id])

  phones Json?
  emails Json?

  electionHistory VoterElectionHistory[]
  scores          VoterScore?
  // FIX: missing back-relation — ContactEvent.voter requires this
  contacts        ContactEvent[]
}

model Election {
  id      Int    @id @default(autoincrement())
  year    Int
  type    String   // "general" | "primary" | "runoff" | "special"
  subtype String   // "presidential" | "midterm" | "party" | etc.

  history VoterElectionHistory[]

  @@unique([year, type, subtype])
}

model VoterElectionHistory {
  voterId    String
  electionId Int

  voted  Boolean
  party  String?  // "Democratic" | "Republican" | null (for generals or non-voters)
  method String?  // "mail" | "early" | "election-day" | null (not in source file)

  voter    Voter    @relation(fields: [voterId], references: [id])
  election Election @relation(fields: [electionId], references: [id])

  @@id([voterId, electionId])
}

model VoterScore {
  voterId         String  @id
  turnoutScore    Float?  // maps to "General_VOTE %" — 0.0–1.0
  persuasionScore Float?  // maps to "Primary_Margin %" — overall primary participation
  partyConfidence Float?  // maps to "Primary_DEM %" — Democratic primary participation rate
  // ADDED: raw counts alongside percentages — useful for weighting scores by
  // sample size (a voter who voted 5/5 generals outweighs one who voted 1/1)
  generalVoteCount   Int?  // "2016-2024 General_VOTE #/5" — numerator
  primaryDemCount    Int?  // "2016-2026 Primary_DEM #/6" — DEM primary appearances
  primaryTotalCount  Int?  // "2016-2026 Primary_Margin #/6" — total primary appearances
  updatedAt DateTime @updatedAt

  voter Voter @relation(fields: [voterId], references: [id])
}

model HouseholdContactSummary {
  householdId    String    @id
  lastContactAt  DateTime?
  totalContacts  Int       @default(0)
  lastResult     String?
  sentimentScore Float?
  doNotContact   Boolean   @default(false)

  household Household @relation(fields: [householdId], references: [id])
}

model Campaign {
  id        String    @id @default(uuid())
  name      String
  startDate DateTime?
  endDate   DateTime?

  scripts       Script[]
  contacts      ContactEvent[]
  // FIX: missing back-relations
  contributions Contribution[]
  expenses      Expense[]
}

model Script {
  id         String   @id @default(uuid())
  campaignId String
  title      String
  content    String
  version    Int
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model ContactEvent {
  id                 String  @id @default(uuid())
  householdId        String
  voterId            String?
  userId             String
  campaignId         String?

  contactType        String
  result             String
  inaccessibleReason String?
  sentiment          String?
  notes              String?

  createdAt DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])
  voter     Voter?    @relation(fields: [voterId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  campaign  Campaign? @relation(fields: [campaignId], references: [id])
}

model MapFeature {
  id         String   @id @default(uuid())
  precinctId Int
  createdBy  String
  type       String
  geometry   Json
  properties Json?

  createdAt DateTime @default(now())

  user     User     @relation(fields: [createdBy], references: [id])
  precinct Precinct @relation(fields: [precinctId], references: [id])
}

/// One logical overlay source (e.g. US House TX, TX Senate). Features may overlap across layers.
model MapBoundaryLayer {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  description String?
  sortOrder   Int                  @default(0)
  features    MapBoundaryFeature[]
}

model MapBoundaryFeature {
  id          String @id @default(uuid())
  layerId     String
  externalKey String?
  label       String?
  /// Native geometry for PostGIS queries — populate via SQL import / Shapefile pipeline.
  geom        Unsupported("geometry(MultiPolygon,4326)")

  layer MapBoundaryLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
}

model Donor {
  id         String  @id @default(uuid())
  name       String
  email      String?
  phone      String?
  employer   String?
  occupation String?

  contributions Contribution[]
}

model Contribution {
  id            String   @id @default(uuid())
  donorId       String
  campaignId    String
  amount        Float
  date          DateTime
  recurring     Boolean
  paymentMethod String?

  donor    Donor    @relation(fields: [donorId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  campaignId  String
  amount      Float
  category    String
  description String?
  date        DateTime

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  tableName String
  recordId  String?
  oldValue  Json?
  newValue  Json?

  createdAt DateTime @default(now())
}
