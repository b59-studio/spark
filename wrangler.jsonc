{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "spark-home",
  "type": "javascript",
  "main": ".output/server/index.js",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Add your environment variables here as needed
  },

  "build": {
    "command": "npm run build:cf",
    "cwd": "."
  },

  "observability": {
    "enabled": true
  }
}
