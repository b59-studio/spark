# Bundle-repo .gitignore (for the coding-standards repo itself).
# These are files that may appear when developing the bundle but
# shouldn't be tracked.

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Editor scratch
.idea/
.vscode/
*.swp
*.swo

# Local-only notes (your personal scratchpad while editing the bundle)
notes.local.md
.scratch/
.ai-notes/
*.ai-tmp

# Test outputs from the eval suite
evals/results/
evals/.cache/

# Python virtual envs if you run eval scripts here
.venv/
__pycache__/
*.pyc

# Node artifacts if any helper tools are added
node_modules/
.npm/
.next/
out/

# TX*Spark — local env and secrets
.env
.env.local
.env*.local

# Coding-standards bundle docs (when docs/ is symlinked from the bundle)
/docs/ROADMAP.md
/docs/SETUP.md
/docs/templates/
