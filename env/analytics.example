# Analytics uses schema `analytics` on the same Neon Postgres as the rest of the app.
# Set DATABASE_URL in .env.local (shared with map/core — migrations only touch schema analytics).

# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# WooCommerce → POST /api/webhooks/woocommerce (configure in WP admin)
# Generate: openssl rand -base64 32
# WOOCOMMERCE_WEBHOOK_SECRET=
