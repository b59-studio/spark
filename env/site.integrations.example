# Copy values into `.env` (local) or your host's secret store (Vercel, DO, Cloudways).
# Never commit real secrets.

# --- Headless WordPress (Cloudways cms or local docker) ---
# Use the same HTTPS origin for all three when MailPoet/Woo run on one WP install.
WORDPRESS_API_URL=https://cms.example.org
# Optional: Application Password for draft/preview fetches
# WORDPRESS_APP_USER=api
# WORDPRESS_APP_PASSWORD=

# --- MailPoet (runs on WordPress; API key in MailPoet → Settings → Advanced) ---
MAILPOET_API_BASE_URL=https://cms.example.org
MAILPOET_API_KEY=
# Optional default list ID for new subscribers
# MAILPOET_LIST_ID=3

# --- WooCommerce (same WordPress host) ---
# Read-only wc/v3 keys drive the headless catalog (/shop). The on-site cart and
# checkout use the public Store API (wc/store/v1) on the same WOOCOMMERCE_API_URL
# host — no extra key needed; the store must allow Store API requests from this
# origin (CORS) for cart/checkout to work.
WOOCOMMERCE_API_URL=https://cms.example.org
WOOCOMMERCE_CONSUMER_KEY=ck_
WOOCOMMERCE_CONSUMER_SECRET=cs_

# --- Stripe (browser publishable key for on-site checkout) ---
# Only the publishable key (pk_...) is used client-side to tokenize the card.
# The secret key and the charge live in the WooCommerce Stripe gateway (WordPress);
# this app never holds a Stripe secret. Leave blank until checkout goes live.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Newsletter fallbacks (used when MailPoet is not configured) ---
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=hello@txspark.org
# RESEND_FROM_EMAIL=hello@txspark.org
# NEWSLETTER_WEBHOOK_URL=
# NEWSLETTER_WEBHOOK_SECRET=

# --- Stripe (on-site one-time donations) ---
# Donations no-op gracefully until both keys are set. Use test keys (sk_test_/pk_test_)
# in development. The publishable key is sent to the browser (NEXT_PUBLIC_ prefix).
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Signing secret from the Stripe webhook endpoint pointing at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Neon Postgres (core + analytics schema) — see env/analytics.example ---
# DATABASE_URL=postgresql://...
# WOOCOMMERCE_WEBHOOK_SECRET=
