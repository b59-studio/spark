# /etc/caddy/Caddyfile  —  what the live CMS droplet actually runs.
#
# The production origin (cms.texasspark.org) is Caddy v2 + php-fpm serving
# WordPress from /var/www/html, behind Cloudflare
# (orange-cloud) with a Cloudflare Origin Certificate. This file is the sanitized
# reference for that setup. The nginx-cms.conf.example alongside it is a legacy
# alternative and is NOT what is deployed.
#
# Reload after edits:  caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

{
    email admin@example.org

    # --- Real client IP behind Cloudflare -------------------------------------
    # Cloudflare terminates TLS and connects to the origin from its own IPs, so
    # without this Caddy (and php-fpm's REMOTE_ADDR) sees a Cloudflare edge IP
    # instead of the visitor. That breaks any IP-based logic — notably Jetpack's
    # brute-force login challenge, which keys on REMOTE_ADDR and would show a math
    # CAPTCHA every login and intermittently invalidate the session.
    # `trusted_proxies` + `client_ip_headers` makes Caddy trust Cloudflare's
    # Cf-Connecting-Ip and set the real client IP for X-Forwarded-For and logs.
    # Refresh ranges from https://www.cloudflare.com/ips/ if they change.
    #
    # NOTE: Caddy's php_fastcgi still sets the fastcgi REMOTE_ADDR to the immediate
    # peer, so the WordPress mu-plugin wp-content/mu-plugins/cloudflare-real-ip.php
    # is what rewrites REMOTE_ADDR for PHP. Keep BOTH.
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers Cf-Connecting-Ip
    }
}

# CMS — served to Cloudflare using the Cloudflare Origin Certificate.
# (Origin Certs are valid ~15 years and need no ACME challenge, which sidesteps
# the HTTP-01 renewal trap that caused the 525 — see runbooks/cms-cloudflare-525.md.)
cms.example.org {
    tls /etc/ssl/cloudflare/example.pem /etc/ssl/cloudflare/example.key

    root * /var/www/html
    php_fastcgi unix//run/php/php8.3-fpm.sock
    file_server

    encode gzip

    # WordPress permalinks (required for the REST API the Next.js app calls).
    try_files {path} {path}/ /index.php?{query}

    # Deny direct access to sensitive files.
    @blocked {
        path */xmlrpc.php
        path */.git/*
        path */wp-config.php
    }
    respond @blocked 403
}
